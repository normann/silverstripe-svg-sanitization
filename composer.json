{
    "name": "normann/silverstripe-svg-sanitization",
    "description": "Sanitises SVG files in Silverstripe CMS, so an uploaded SVG can't run script or load remote resources: uploads are cleaned before they're stored, and a task cleans files already in the asset store.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "svg",
        "sanitize",
        "sanitise",
        "xss",
        "security",
        "upload",
        "assets"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Normann Lou",
            "homepage": "https://github.com/normann"
        }
    ],
    "support": {
        "issues": "https://github.com/normann/silverstripe-svg-sanitization/issues"
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "silverstripe/framework": "^6",
        "silverstripe/assets": "^3",
        "silverstripe/versioned": "^3",
        "enshrined/svg-sanitize": "^1.1.1"
    },
    "require-dev": {
        "silverstripe/mimevalidator": "^4",
        "silverstripe/recipe-testing": "^4",
        "squizlabs/php_codesniffer": "^3 || ^4"
    },
    "suggest": {
        "silverstripe/mimevalidator": "Checks that uploaded files' contents match their extension. Use SvgSanitisingMimeUploadValidator to combine it with SVG sanitising"
    },
    "autoload": {
        "psr-4": {
            "Normann\\SvgSanitization\\": "src/",
            "Normann\\SvgSanitization\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint-clean": "phpcbf"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    }
}
